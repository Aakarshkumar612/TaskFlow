# ──────────────────────────────────────────────
# TASKFLOW - Docker Environment Template
#
# Copy this file to .env and fill in your values:
#   cp .env.docker .env
#
# Required: Clerk API keys from https://dashboard.clerk.com
# Optional: Database credentials (defaults work for Docker)
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# Clerk Authentication
# Get these from: https://dashboard.clerk.com
# ──────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ──────────────────────────────────────────────
# Database (optional - defaults work in Docker)
# ──────────────────────────────────────────────
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=taskflow
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/taskflow

# ──────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────
# PORT=5000
# FRONTEND_URL=http://localhost:3000
